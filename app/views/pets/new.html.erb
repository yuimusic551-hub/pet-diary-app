<h1>新しいペットの登録</h1>

<%= form_with model: @pet, local: true do |f| %>
  <%# エラーメッセージ（日本語化設定が効きます！） %>
  <% if @pet.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@pet.errors.count, "個") %>のエラーがあります。</h2>
      <ul>
        <% @pet.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name %><br />
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :species_id %><br />
    <%= f.collection_select(:species_id, Species.all, :id, :name, {}, {class:"select-box"}) %>
  </div>

  <div>
    <%= f.label :birth_date %><br />
    <%= f.date_select :birth_date, use_month_numbers: true, start_year: 2000, end_year: Time.now.year %>
  </div>

  <div>
    <%= f.label :gender_id %><br />
    <%= f.collection_select(:gender_id, Gender.all, :id, :name, {}, {class:"select-box"}) %>
  </div>

  <div>
    <%= f.submit "登録する" %>
  </div>
<% end %>