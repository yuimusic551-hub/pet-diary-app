<style>
  /* 1. 全体の背景（桜が舞う舞台） */
  .auth-wrapper {
    background-color: #fff5f7; /* ほんのり桜色 */
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: 'Zen Maru Gothic', 'Hiragino Sans', sans-serif;
    padding: 20px;
    position: relative;
    overflow: hidden;
  }

  /* 2. 桜の花びらが舞い落ちるアニメーション */
  @keyframes sakura-fall {
    0% {
      top: -10%;
      left: -5%;
      transform: rotate(0deg) translateX(0);
    }
    100% {
      top: 110%;
      left: 105%;
      transform: rotate(720deg) translateX(100px); /* 回転しながら横に流れる */
    }
  }

  .sakura {
    position: absolute;
    pointer-events: none;
    animation: sakura-fall 15s linear infinite;
    opacity: 0.8;
    z-index: 1;
    font-size: 30px; /* 基本サイズ */
  }

  /* 花びらごとの個別設定（大きさ・速さ・位置） */
  .p1 { top: -10%; left: 10%; font-size: 80px; animation-duration: 12s; opacity: 0.6; } /* ★一番大きくて速い花びら */
  .p2 { top: -10%; left: 30%; font-size: 30px; animation-duration: 18s; animation-delay: -2s; }
  .p3 { top: -10%; left: 60%; font-size: 40px; animation-duration: 15s; animation-delay: -5s; }
  .p4 { top: -10%; left: 80%; font-size: 25px; animation-duration: 20s; animation-delay: -7s; }

  /* 3. ログインカード */
  .auth-card {
    background: rgba(255, 255, 255, 0.95);
    padding: 40px;
    border-radius: 30px;
    box-shadow: 0 10px 30px rgba(255, 182, 193, 0.2); /* 影も少しピンク */
    width: 100%;
    max-width: 400px;
    border: 1px solid #ffe4e8;
    text-align: center;
    z-index: 10;
  }

  h2 { color: #d81b60; margin-bottom: 30px; font-size: 24px; }

  .field { margin-bottom: 20px; text-align: left; }
  label { color: #ad1457; font-weight: bold; display: block; margin-bottom: 8px; }

  input[type="email"], input[type="password"] {
    width: 100%;
    padding: 12px;
    border: 2px solid #ffe4e8;
    border-radius: 12px;
    box-sizing: border-box;
    outline: none;
    background: #fffafa;
  }

  /* 4. ログインボタン（桜に合わせたピンク系） */
  .actions input {
    background-color: #ff80ab; /* 桜ピンク */
    color: white;
    border: none;
    padding: 16px;
    width: 100%;
    border-radius: 50px;
    font-size: 20px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 5px 0 #f06292;
    margin-top: 15px;
  }

  .actions input:active {
    box-shadow: none;
    transform: translateY(5px);
  }

  .links { margin-top: 25px; border-top: 1px dotted #ffc1cc; padding-top: 15px; }
  .links a { color: #f06292; text-decoration: none; font-size: 14px; }
</style>

<div class="auth-wrapper">
  <div class="sakura p1">🌸</div>
  <div class="sakura p2">🌸</div>
  <div class="sakura p3">🌸</div>
  <div class="sakura p4">🌸</div>

  <div class="auth-card">
    <h2>🌸 おかえりなさい 🌸</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autofocus: true, placeholder: "example@mail.com" %>
      </div>

      <div class="field">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field" style="display: flex; align-items: center; gap: 8px;">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "ログイン状態を保持する", style: "margin-bottom: 0; font-size: 14px; font-weight: normal;" %>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "ログイン" %>
      </div>
    <% end %>

    <div class="links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>