<style>
  /* 🌸 全体の背景設定 */
  .auth-wrapper {
    background-color: #fff5f7;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: 'Zen Maru Gothic', 'Hiragino Sans', sans-serif;
    padding: 20px;
    position: relative;
    overflow: hidden;
  }

  /* 🌸 桜のアニメーション */
  @keyframes sakura-fall {
    0% { top: -10%; left: -5%; transform: rotate(0deg) translateX(0); }
    100% { top: 110%; left: 105%; transform: rotate(720deg) translateX(100px); }
  }

  .sakura {
    position: absolute;
    pointer-events: none;
    animation: sakura-fall 15s linear infinite;
    opacity: 0.8;
    z-index: 1;
  }

  .p1 { top: -10%; left: 10%; font-size: 80px; animation-duration: 12s; }
  .p2 { top: -10%; left: 30%; font-size: 30px; animation-duration: 18s; }
  .p3 { top: -10%; left: 60%; font-size: 40px; animation-duration: 15s; }
  .p4 { top: -10%; left: 80%; font-size: 25px; animation-duration: 20s; }

  /* 🌸 入力カード */
  .auth-card {
    background: rgba(255, 255, 255, 0.95);
    padding: 40px;
    border-radius: 30px;
    box-shadow: 0 10px 30px rgba(255, 182, 193, 0.2);
    width: 100%;
    max-width: 450px; /* 少し広くしました */
    border: 1px solid #ffe4e8;
    text-align: center;
    z-index: 10;
    position: relative;
  }

  .auth-card h2 { color: #d81b60; margin-bottom: 25px; font-size: 24px; font-weight: bold; }
  
  .field { margin-bottom: 25px; text-align: left; }
  .field label { color: #ad1457; font-weight: bold; display: block; margin-bottom: 8px; font-size: 16px; }
  
  /* 入力欄の共通デザイン */
  .input-style {
    width: 100%;
    padding: 15px;
    border: 2px solid #ffe4e8;
    border-radius: 15px;
    box-sizing: border-box;
    background: #fffafa;
    font-size: 18px;
    outline: none;
    transition: all 0.3s;
  }

  .input-style:focus {
    border-color: #f06292;
    background: white;
    box-shadow: 0 0 10px rgba(240, 98, 146, 0.1);
  }

  /* 🌸 登録ボタン */
  .actions input {
    background-color: #f06292;
    color: white;
    border: none;
    padding: 18px;
    width: 100%;
    border-radius: 50px;
    font-size: 22px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 6px 0 #c2185b;
    margin-top: 15px;
    transition: all 0.1s;
  }

  .actions input:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 #c2185b;
  }

  /* 🌸 エラーメッセージ */
  #error_explanation {
    background: #fff0f5;
    border-radius: 15px;
    padding: 15px;
    margin-bottom: 20px;
    color: #d81b60;
    font-size: 13px;
    text-align: left;
    border: 1px solid #ffc1cc;
    max-height: 160px;
    overflow-y: auto;
  }
  #error_explanation h2 { display: none; }
  #error_explanation ul { list-style: "🌸 "; padding-left: 20px; margin: 0; }

  .links { margin-top: 25px; border-top: 1px dotted #ffc1cc; padding-top: 15px; }
  .links a { color: #f06292; text-decoration: none; font-size: 14px; font-weight: bold; }
</style>

<div class="auth-wrapper">
  <div class="sakura p1">🌸</div>
  <div class="sakura p2">🌸</div>
  <div class="sakura p3">🌸</div>
  <div class="sakura p4">🌸</div>

  <div class="auth-card">
    <h2>🌸 はじめまして 🌸</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%# エラー通知を表示 %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%# ニックネーム %>
      <div class="field">
        <%= f.label :name, "ニックネーム（お名前）" %>
        <%= f.text_field :name, autofocus: true, placeholder: "例：はなこ", required: true, class: "input-style" %>
        <p style="color: #f06292; font-size: 13px; margin-top: 5px;">※ 日記帳の表紙にお名前が載ります 🌸</p>
      </div>

      <%# メールアドレス %>
      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "お使いのメールアドレス", class: "input-style" %>
      </div>

      <%# パスワード %>
      <div class="field">
        <%= f.label :password, "パスワード（10文字以上）" %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "10文字以上で決めてね", required: true, class: "input-style" %>
        <p style="color: #888; font-size: 13px; margin-top: 5px;">※ 忘れないようにメモしておいてくださいね 📝</p>
      </div>

      <%# パスワード（確認用） %>
      <div class="field">
        <%= f.label :password_confirmation, "パスワード（もういちど）" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "おなじパスワードを入力", required: true, class: "input-style" %>
      </div>

      <div class="actions">
        <%= f.submit "登録する" %>
      </div>
    <% end %>

    <div class="links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>