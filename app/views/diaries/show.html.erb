<div class="mypage-wrapper" style="background-color: #fdfaf4; min-height: 100vh; padding: 40px 20px; font-family: 'Zen Maru Gothic', sans-serif;">
  <div style="max-width: 700px; margin: 0 auto; background: white; border-radius: 40px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1); border: 2px solid #ffedcc;">
    
    <%# 写真を表示 %>
    <div style="width: 100%; background: #fff9f0;">
      <% if @diary.image.attached? %>
        <%= image_tag @diary.image, style: "width: 100%; height: auto; display: block;" %>
      <% else %>
        <div style="padding: 100px 0; text-align: center; color: #ccc; font-size: 20px;">No Photo 🐾</div>
      <% end %>
    </div>

    <%# 中身を表示 %>
    <div style="padding: 30px; text-align: left;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div style="color: #8d6e63; font-weight: bold; font-size: 20px;">
          📅 <%= @diary.created_at.strftime('%Y年%m月%d日') %>
        </div>
        <% if @diary.animal_id %>
          <div style="background: #ff9800; color: white; padding: 5px 15px; border-radius: 20px; font-size: 14px; font-weight: bold;">
            🐾 <%= Animal.find(@diary.animal_id).name %>
          </div>
        <% end %>
      </div>

      <h1 style="color: #444; font-size: 28px; margin-bottom: 20px; border-bottom: 2px solid #fff3e0; padding-bottom: 10px;">
        <%= @diary.title %>
      </h1>

      <div style="color: #555; font-size: 18px; line-height: 1.8; white-space: pre-wrap;"><%= @diary.content %></div>

      <div style="margin-top: 40px; display: flex; gap: 20px; border-top: 1px solid #eee; padding-top: 20px;">
        <%= link_to '✏️ 直す', edit_diary_path(@diary), style: "text-decoration: none; color: #666; font-weight: bold;" %>
        <%= link_to '← もどる', diaries_path, style: "text-decoration: none; color: #ff9800; font-weight: bold;" %>
      </div>
    </div>
  </div>
</div>