<style>
  /* 🌸 全体の背景設定 */
  .new-diary-wrapper { 
    background-color: #fdfaf4; 
    min-height: 100vh; 
    padding: 80px 20px; 
    font-family: 'Zen Maru Gothic', sans-serif; 
  }
  
  /* 🌸 入力カード：幅を広げて存在感をアップ */
  .form-container { 
    max-width: 850px; /* 700pxから850pxに拡大 */
    margin: 0 auto; 
    background: white; 
    padding: 80px 60px; /* 上下余白を60pxから80pxに増やして縦長に */
    border-radius: 50px; 
    box-shadow: 0 20px 50px rgba(0,0,0,0.06); 
    border: 1px solid #eee; 
    position: relative; 
  }

  /* 🐹 枠内の左側に配置されるハムちゃん */
  .hamchibi-inner-left {
    position: absolute;
    left: 20px;   /* 枠の左端からの距離 */
    top: 20px;    /* 枠の上端からの距離 */
    width: 350px; /* ✅ お母様が見やすいサイズ（300pxだと大きすぎて入力欄に重なるため100pxに調整しています） */
    height: auto;
    animation: ham-yura 2s ease-in-out infinite;
    z-index: 5;
    pointer-events: none; /* ハムちゃんがボタンに重なってもクリックできるようにします */
  }

  /* ✨ ゆらゆらアニメーション */
  @keyframes ham-yura {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  .form-title { 
    color: #8bc34a; 
    font-size: 32px; 
    font-weight: bold; 
    text-align: center;
    margin-top: 10px; 
    margin-bottom: 10px;
  }

  .form-subtitle {
    color: #8d6e63;
    text-align: center;
    margin-bottom: 35px;
    font-size: 18px;
    line-height: 1.6;
  }

  /* --- 入力欄スタイル --- */
  .input-label { display: block; color: #555; font-weight: bold; font-size: 20px; margin-bottom: 12px; }
  .input-field { width: 100%; padding: 18px; border: 2px solid #e0e0e0; border-radius: 20px; font-size: 20px; margin-bottom: 30px; box-sizing: border-box; background-color: #fafafa; outline: none; }
  
  /* 🌸 年齢を調べるボタン（ここも肉球に） */
  .search-age-btn { 
    text-decoration: none; 
    display: inline-block; 
    background: #fff; 
    color: #e67e22; 
    padding: 8px 15px; 
    border-radius: 50px; 
    font-weight: bold; 
    font-size: 15px; 
    border: 2px solid #ffcc80; 
    transition: 0.2s;
  }
  .search-age-btn:hover {
    cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' style='font-size:24px;'><text y='24'>🐾</text></svg>"), auto !important;
    background-color: #fff9f0;
  }

  /* 📸 写真選択エリア */
  .image-upload-box { background-color: #fff9f0; border: 3px dashed #ffcc80; padding: 30px; border-radius: 25px; text-align: center; margin-bottom: 40px; }
  
  /* 🐾 写真を選ぶボタン */
  .paw-button { 
    display: inline-block; 
    background-color: #ffcc80; 
    color: #e67e22; 
    padding: 15px 40px; 
    border-radius: 50px; 
    font-size: 22px; 
    font-weight: bold; 
    box-shadow: 0 4px 0 #ffb74d; 
    transition: all 0.2s;
    cursor: pointer;
  }
  .paw-button:hover {
    background-color: #ffb74d;
    transform: scale(1.05);
    /* ✅ 肉球カーソルを強制適用 */
    cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' style='font-size:24px;'><text y='24'>🐾</text></svg>"), auto !important;
  }

  /* 💾 日記を保存するボタン */
  .save-btn { 
    background-color: #ff9800; 
    color: white; 
    width: 100%; 
    padding: 22px; 
    border: none; 
    border-radius: 60px; 
    font-size: 26px; 
    font-weight: bold; 
    box-shadow: 0 8px 0 #e68a00; 
    transition: 0.1s;
    cursor: pointer;
  }
  .save-btn:hover {
    background-color: #ffa726;
    transform: translateY(-2px);
    box-shadow: 0 10px 0 #e68a00;
    /* ✅ 肉球カーソルを強制適用 */
    cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' style='font-size:24px;'><text y='24'>🐾</text></svg>"), auto !important;
  }
  .save-btn:active { transform: translateY(6px); box-shadow: 0 2px 0 #e68a00; }

  .back-link { display: block; text-align: center; margin-top: 30px; color: #999; text-decoration: none; font-size: 16px; }
  .back-link:hover { cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' style='font-size:24px;'><text y='24'>🐾</text></svg>"), auto !important; }
</style>

<div class="new-diary-wrapper">
  <div class="form-container">
    
    <%# --- 🐹 枠内の左上に配置（ハムちゃん） --- %>
    <%= image_tag "hamchibi_.png", class: "hamchibi-inner-left" %>

    <h2 class="form-title">うちの子日記 🐾</h2>

    <p class="form-subtitle">
      今日のかわいい姿や、<br>元気な様子を記録しましょう。
    </p>

    <%= form_with(model: @diary, local: true) do |f| %>
      <%# 1. ペットの選択 %>
      <div style="margin-bottom: 30px;">
        <%= f.label :animal_id, "主役はどの子？ 🐾", class: "input-label" %>
        <%= f.collection_select :animal_id, current_user.animals, :id, :name, 
            { prompt: "うちの子を選んでね" }, 
            { class: "input-field", style: "background-color: #fff9f0; border: 2px solid #ffedcc;" } %>
      <%# --- 🌸 ここから下のリンクを復活 --- %>
        <p style="font-size: 20px; color: #ff9800; margin-top: 5px; margin-left: 10px; font-weight: bold;">
          ※ まだ登録していない場合は 
          <%= link_to "こちらから登録 🐾", new_animal_path, 
              style: "color: #ff9800; text-decoration: underline; transition: 0.2s;", 
              onmouseover: "this.style.cursor='url(\"data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'32\\' height=\\'32\\' style=\\'font-size:24px;\\'><text y=\\'24\\'>🐾</text></svg>\"), auto' " %>
        </p>
      </div>

      <%# 2. 日記のタイトル %>
      <div style="margin-bottom: 25px;">
        <%= f.label :title, "今日の一言（タイトル）", class: "input-label" %>
        <%= f.text_field :title, placeholder: "例：お気に入りの場所でお昼寝", class: "input-field" %>
      </div>

      <%# 🎂 誕生日 %>
      <div style="margin-bottom: 30px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
          <label class="input-label" style="margin-bottom: 0;">うちの子の誕生日</label>
          <%= link_to age_chart_path, target: "_blank", class: "search-age-btn" do %>
            🔍 年齢を調べる 🐾
          <% end %>
        </div>
        <%= f.date_field :birthday, class: "input-field" %>
      </div>

      <%# 本文 %>
      <div>
        <%= f.label :content, "今日のできごと", class: "input-label" %>
        <%= f.text_area :content, placeholder: "どんな様子だったか、ゆっくり書いてね", class: "input-field", style: "height: 300px;" %>
      </div>

      <%# 📸 写真選択エリア %>
      <div style="margin-bottom: 30px;">
        <label class="input-label">今日の写真 📸</label>
        <div class="image-upload-box">
          <label class="paw-button">
            <%= f.file_field :image, accept: 'image/*', style: "display: none;", id: "image-upload-input" %>
            🐾 写真を選ぶ
          </label>
          <p id="file-name-display" style="color: #e67e22; font-size: 16px; font-weight: bold; margin-top: 20px;">
            ※ ボタンを押すと、写真がえらべます 🐾
          </p>
        </div>
      </div>

      <%= f.submit "日記を保存する 🐶🐾", class: "save-btn" %>
    <% end %>

    <%= link_to "← もどる", diaries_path, class: "back-link" %>
  </div>
</div>

<script>
  document.getElementById('image-upload-input').addEventListener('change', function(e) {
    if (e.target.files.length > 0) {
      document.getElementById('file-name-display').innerText = "選ばれた写真： " + e.target.files[0].name + " ✅";
    }
  });
</script>