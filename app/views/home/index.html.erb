<style>
  /* --- 共通設定 --- */
  .top-wrapper {
    background-color: #fdfaf4;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px;
    font-family: 'Zen Maru Gothic', 'Hiragino Sans', sans-serif;
    position: relative;
    overflow: hidden;
  }

  /* --- ボタンエリア --- */
  .btn-area {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    z-index: 15;
  }

  .login-link-wrap {
    display: block;
    width: fit-content;
    line-height: 0;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .login-image-btn {
    width: 320px;
    height: auto;
    display: block;
    cursor: pointer;
    transition: all 0.1s;
  }

  .login-link-wrap:active .login-image-btn {
    transform: translateY(6px);
    filter: brightness(0.9);
  }

  /* --- ログイン状態通知ボックス --- */
  .status-info-area {
    margin-top: 25px;
    text-align: center;
  }
  .status-box {
    background-color: rgba(255, 255, 255, 0.9);
    border: 2px solid #f08e91;
    padding: 15px 30px;
    border-radius: 30px;
    display: inline-block;
  }
  .status-msg {
    color: #d81b60;
    font-size: 15px;
    font-weight: bold;
    display: block;
    margin-bottom: 10px;
  }

  /* --- ボタンのデザイン（日記へ・ログアウト） --- */
  .go-diaries-btn {
    background-color: #8bc34a;
    color: white !important;
    text-decoration: none;
    padding: 8px 20px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: bold;
    box-shadow: 0 3px 0 #689f38;
    display: inline-block;
    transition: 0.1s;
  }
  .go-diaries-btn:active { transform: translateY(2px); box-shadow: none; }

  .logout-btn {
    background-color: #f06292;
    color: white !important;
    text-decoration: none;
    padding: 8px 20px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: bold;
    box-shadow: 0 3px 0 #c2185b;
    display: inline-block;
  }
  .logout-btn:active { transform: translateY(2px); box-shadow: none; }

  /* --- 装飾要素 --- */
  .main-title { color: #5d4037; font-size: 48px; margin-bottom: 40px; z-index: 10; }
  .photo-frame { background: white; padding: 15px 15px 55px 15px; box-shadow: 0 12px 30px rgba(0,0,0,0.1); border: 1px solid #eee; margin-bottom: 50px; transform: rotate(-1.5deg); display: inline-block; width: 90%; max-width: 650px; z-index: 10; }
  .catch-phrase { color: #8d6e63; font-size: 20px; font-weight: bold; margin-bottom: 50px; z-index: 10; }

  @keyframes roll-seed { 0% { left: -200px; transform: rotate(0deg); } 100% { left: 110%; transform: rotate(720deg); } }
  .moving-seed { position: absolute; pointer-events: none; animation: roll-seed 18s linear infinite; opacity: 0.9; z-index: 1; }
  .s1 { top: 5%; width: 150px; animation-duration: 12s; }
  .s2 { top: 35%; width: 60px;  animation-duration: 22s; animation-delay: -5s; }
  .s3 { top: 65%; width: 90px;  animation-duration: 16s; animation-delay: -2s; }
  .s4 { top: 85%; width: 70px;  animation-duration: 25s; animation-delay: -10s; }

  /* --- 【ここがスマホ対応！】 --- */
  @media (max-width: 600px) {
    .main-title { font-size: 32px; margin-bottom: 20px; }
    .photo-frame { width: 95%; padding: 10px 10px 40px 10px; margin-bottom: 30px; }
    .catch-phrase { font-size: 16px; margin-bottom: 30px; padding: 0 10px; }
    .login-image-btn { width: 280px; } /* スマホではボタンを少し小さく */
    .status-box { padding: 12px 20px; width: 90%; }
    .status-msg { font-size: 13px; }
    .go-diaries-btn, .logout-btn { font-size: 12px; padding: 6px 15px; }
  }
</style>

<div class="top-wrapper">
  <%= image_tag 'sunflower_seed.png', class: 'moving-seed s1' %>
  <%= image_tag 'sunflower_seed.png', class: 'moving-seed s2' %>
  <%= image_tag 'sunflower_seed.png', class: 'moving-seed s3' %>
  <%= image_tag 'sunflower_seed.png', class: 'moving-seed s4' %>

  <h1 class="main-title">🌻 うちの子日記 🌻</h1>

  <div class="photo-frame">
    <%= image_tag 'hamster_.jpg', style: 'width: 100%; display: block;' %>
  </div>

  <p class="catch-phrase">
    大切な家族の思い出を、コロコロ記録しましょう。
  </p>

  <div class="btn-area">
    <%= link_to new_user_session_path, class: "login-link-wrap" do %>
      <%= image_tag 'login_btn_wood.jpg', class: 'login-image-btn' %>
    <% end %>

    <% if user_signed_in? || flash.any? %>
      <div class="status-info-area">
        <div class="status-box">
          <span class="status-msg">
            <% if flash.any? %>
              <% flash.each do |name, msg| %><%= msg %><% end %>
            <% else %>
              おかえりなさい！ログイン中です 🐾
            <% end %>
          </span>

          <div style="margin-top: 10px; display: flex; gap: 10px; justify-content: center; align-items: center; flex-wrap: wrap;">
            <% if user_signed_in? %>
              <%= link_to "日記帳をみる", diaries_path, class: "go-diaries-btn" %>
              <%= link_to "ログアウト", destroy_user_session_path, 
                          data: { turbo_method: :delete }, 
                          class: "logout-btn" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>