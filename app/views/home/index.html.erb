<style>
  /* --- 共通設定 --- */
  .top-wrapper {
    background-color: #fdfaf4;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px;
    font-family: 'Zen Maru Gothic', 'Hiragino Sans', sans-serif;
    position: relative;
    overflow: hidden;
  }

  /* --- 🌻 メインタイトル --- */
  .main-title { 
    color: #5d4037; 
    /* PCで見栄えがするように少しサイズアップ */
    font-size: clamp(32px, 6vw, 54px); 
    margin-bottom: 40px; 
    z-index: 10; 
    font-weight: bold; 
  }

  /* --- 📸 写真フレーム --- */
  .photo-frame { 
    background: white; 
    padding: 15px 15px 55px 15px; 
    box-shadow: 0 12px 30px rgba(0,0,0,0.1); 
    border: 1px solid #eee; 
    margin-bottom: 50px; 
    transform: rotate(-1.5deg); 
    display: inline-block; 
    width: 90%; 
    max-width: 650px; 
    z-index: 10; 
  }

  /* --- ✨ キャッチコピー：PCでも見やすく大きく修正 --- */
  .catch-phrase { 
    color: #8d6e63; 
    /* スマホでは20px、PCでは最大32pxまで拡大 */
    font-size: clamp(20px, 4vw, 32px); 
    font-weight: bold; 
    margin-bottom: 50px; 
    z-index: 10; 
    text-align: center;
    line-height: 1.6;
    letter-spacing: 0.05em;
  }

  /* --- ボタンエリア --- */
  .btn-area {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    z-index: 15;
  }

  /* --- 🐾 共通：肉球カーソルの設定 --- */
  .login-link-wrap:hover,
  .go-diaries-btn:hover,
  .logout-btn:hover {
    cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' style='font-size:24px;'><text y='24'>🐾</text></svg>"), auto;
  }

  .login-link-wrap {
    display: block;
    width: fit-content;
    line-height: 0;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .login-image-btn {
    width: 320px;
    height: auto;
    display: block;
    transition: all 0.2s;
  }

  .login-link-wrap:hover .login-image-btn {
    transform: scale(1.05);
  }

  .login-link-wrap:active .login-image-btn {
    transform: translateY(6px) scale(1.0);
    filter: brightness(0.9);
  }

  /* --- ログイン状態通知ボックス --- */
  .status-info-area {
    margin-top: 25px;
    text-align: center;
  }
  .status-box {
    background-color: rgba(255, 255, 255, 0.9);
    border: 2px solid #f08e91;
    padding: 15px 30px;
    border-radius: 30px;
    display: inline-block;
  }
  .status-msg {
    color: #d81b60;
    font-size: 16px;
    font-weight: bold;
    display: block;
    margin-bottom: 10px;
  }

  /* --- ボタンのデザイン --- */
  .go-diaries-btn, .logout-btn {
    text-decoration: none;
    padding: 12px 25px; /* 少し大きくしてPCでも押しやすく */
    border-radius: 25px;
    font-size: 16px;
    font-weight: bold;
    display: inline-block;
    transition: 0.2s;
  }

  .go-diaries-btn {
    background-color: #8bc34a;
    color: white !important;
    box-shadow: 0 4px 0 #689f38;
  }
  .go-diaries-btn:active { transform: translateY(2px); box-shadow: none; }

  .logout-btn {
    background-color: #f06292;
    color: white !important;
    box-shadow: 0 4px 0 #c2185b;
  }
  .logout-btn:active { transform: translateY(2px); box-shadow: none; }

  /* --- 🌻 流れるひまわりの種 --- */
  @keyframes roll-seed { 0% { left: -200px; transform: rotate(0deg); } 100% { left: 110%; transform: rotate(720deg); } }
  .moving-seed { position: absolute; pointer-events: none; animation: roll-seed 18s linear infinite; opacity: 0.9; z-index: 1; }
  .s1 { top: 5%; width: 150px; animation-duration: 12s; }
  .s2 { top: 35%; width: 60px;  animation-duration: 22s; animation-delay: -5s; }
  .s3 { top: 65%; width: 90px;  animation-duration: 16s; animation-delay: -2s; }
  .s4 { top: 85%; width: 70px;  animation-duration: 25s; animation-delay: -10s; }

  /* スマホ対応の微調整 */
  @media (max-width: 600px) {
    .photo-frame { width: 95%; padding: 10px 10px 40px 10px; margin-bottom: 30px; }
    .login-image-btn { width: 280px; }
    .status-box { padding: 12px 20px; width: 95%; }
  }
</style>

<div class="top-wrapper">
  <%= image_tag 'sunflower_seed.png', class: 'moving-seed s1' %>
  <%= image_tag 'sunflower_seed.png', class: 'moving-seed s2' %>
  <%= image_tag 'sunflower_seed.png', class: 'moving-seed s3' %>
  <%= image_tag 'sunflower_seed.png', class: 'moving-seed s4' %>

  <h1 class="main-title">🌻 うちの子日記 🌻</h1>

  <div class="photo-frame">
    <%= image_tag 'hamster_.jpg', style: 'width: 100%; display: block;' %>
  </div>

  <p class="catch-phrase">
    大切な家族の思い出を、<br>コロコロ記録しましょう。
  </p>

  <div class="btn-area">
    <%# ログインリンク：ホバーで肉球に変わります %>
    <%= link_to new_user_session_path, class: "login-link-wrap" do %>
      <%= image_tag 'login_btn_wood.jpg', class: 'login-image-btn' %>
    <% end %>

    <% if user_signed_in? || flash.any? %>
      <div class="status-info-area">
        <div class="status-box">
          <span class="status-msg">
            <% if flash.any? %>
              <% flash.each do |name, msg| %><%= msg %><% end %>
            <% else %>
              おかえりなさい！ログイン中ですよ 🐾
            <% end %>
          </span>

          <div style="margin-top: 15px; display: flex; gap: 15px; justify-content: center; align-items: center; flex-wrap: wrap;">
            <% if user_signed_in? %>
              <%= link_to "日記帳をみる", diaries_path, class: "go-diaries-btn" %>
              <%= link_to "ログアウト", destroy_user_session_path, 
                          data: { turbo_method: :delete }, 
                          class: "logout-btn" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>