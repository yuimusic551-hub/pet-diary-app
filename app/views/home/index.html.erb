<style>
  /* 全体の背景設定 */
  .top-wrapper {
    background-color: #fdfaf4;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px;
    font-family: 'Zen Maru Gothic', 'Hiragino Sans', sans-serif;
    position: relative;
    overflow: hidden;
  }

  /* 種のアニメーション */
  @keyframes roll-seed {
    0% { left: -200px; transform: rotate(0deg); }
    100% { left: 110%; transform: rotate(720deg); }
  }

  .moving-seed {
    position: absolute;
    pointer-events: none;
    animation: roll-seed 18s linear infinite;
    opacity: 0.9;
    z-index: 1;
  }

  .s1 { top: 5%; width: 150px; animation-duration: 12s; }
  .s2 { top: 35%; width: 60px;  animation-duration: 22s; animation-delay: -5s; }
  .s3 { top: 65%; width: 90px;  animation-duration: 16s; animation-delay: -2s; }
  .s4 { top: 85%; width: 70px;  animation-duration: 25s; animation-delay: -10s; }

  /* タイトル */
  .main-title {
    color: #5d4037;
    font-size: 48px;
    margin-bottom: 40px;
    z-index: 10;
  }

  /* 写真フレーム */
  .photo-frame {
    background: white;
    padding: 15px 15px 55px 15px; 
    box-shadow: 0 12px 30px rgba(0,0,0,0.1);
    border: 1px solid #eee;
    margin-bottom: 50px;
    transform: rotate(-1.5deg);
    display: inline-block;
    width: 90%;
    max-width: 650px;
    z-index: 10;
  }

  /* キャッチコピー */
  .catch-phrase {
    color: #8d6e63;
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 50px;
    z-index: 10;
  }

  /* --- 木目調ボタンの設定 --- */
  .btn-area {
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
    max-width: 550px; /* 画像が少し横長なので少し広めに */
    z-index: 15;
  }

  .login-image-btn {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
    transition: transform 0.1s; /* 押し心地を少しクイックに */
  }

  /* 押した時に「ポチッ」と沈む演出 */
  .login-image-btn:active {
    transform: translateY(4px) scale(0.98); /* わずかに小さくして沈み込みを表現 */
    filter: brightness(0.95);
  }

  /* スマホ対応 */
  @media (max-width: 600px) {
    .main-title { font-size: 32px; }
    .photo-frame { width: 95%; }
    .catch-phrase { font-size: 16px; }
  }
</style>

<div class="top-wrapper">
  
  <%= image_tag 'sunflower_seed.png', class: 'moving-seed s1' %>
  <%= image_tag 'sunflower_seed.png', class: 'moving-seed s2' %>
  <%= image_tag 'sunflower_seed.png', class: 'moving-seed s3' %>
  <%= image_tag 'sunflower_seed.png', class: 'moving-seed s4' %>

  <h1 class="main-title">🌻 うちの子日記 🌻</h1>

  <div class="photo-frame">
    <%= image_tag 'hamster_.jpg', style: 'width: 100%; display: block;' %>
  </div>

  <p class="catch-phrase">
    大切な家族の思い出を、コロコロ記録しましょう。
  </p>

  <div class="btn-area">
    <%= link_to new_user_session_path do %>
      <%= image_tag 'login_btn_wood.jpg', class: 'login-image-btn' %>
    <% end %>
  </div>

</div>